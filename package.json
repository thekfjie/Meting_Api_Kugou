{
  "name": "@meting/server",
  "version": "1.10.0",
  "main": "src/index.js",
  "type": "module",
  "author": "metowolf",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/index.js",
    "start:upstream": "npm --prefix KuGouMusicApi start -- --platform=default --port=3100",
    "start:upstream:lite": "npm --prefix KuGouMusicApi start -- --platform=lite --port=3101",
    "dev": "nodemon src/index.js",
    "lint": "node --max-old-space-size=128 node_modules/eslint/bin/eslint.js src scripts test ecosystem.config.cjs eslint.config.js",
    "test": "node --max-old-space-size=128 --test --test-concurrency=1 test/*.test.js KuGouMusicApi/module/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@meting/core": "^1.6.1",
    "dotenv": "^17.2.3",
    "hash.js": "^1.1.7",
    "hono": "^4.11.10",
    "lru-cache": "^11.2.2",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "eslint": "^8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-standard": "^5.0.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.2"
  }
}
