# API server. Docker Compose always uses port 3000 inside the container.
HTTP_PORT=3000
HTTP_PREFIX=
METING_URL=http://localhost:3000
METING_TOKEN=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-another-random-secret
TZ=Asia/Shanghai

# PM2 / local upstream addresses. Compose overrides these with service names.
METING_KUGOU_UPSTREAM_DEFAULT_URL=http://127.0.0.1:3100
METING_KUGOU_UPSTREAM_LITE_URL=http://127.0.0.1:3101
METING_KUGOU_UPSTREAM_TIMEOUT_MS=8000
METING_KUGOU_PREMIUM_PLATFORM=default
METING_KUGOU_GENERAL_PLATFORM=lite

# Optional key for the premium pool; separate from resource URL signatures.
METING_KUGOU_PREMIUM_KEY=
METING_COOKIE_ALLOW_HOSTS=

# Leave these empty when managing cookies through the admin page.
METING_COOKIE_KUGOU_PREMIUM=
METING_COOKIE_KUGOU_GENERAL=

# Existing scheduler: refresh file pools and optionally claim lite VIP.
METING_KUGOU_PREMIUM_AUTO_CLAIM=0
METING_KUGOU_GENERAL_AUTO_CLAIM=1
METING_KUGOU_AUTO_REFRESH_BASE_MS=21600000
METING_KUGOU_AUTO_REFRESH_JITTER_MS=3600000
METING_KUGOU_AUTO_CLAIM_START_HOUR=9
METING_KUGOU_AUTO_CLAIM_END_HOUR=21

# Optional: host port for Compose and upstream device identities for both modes.
METING_BIND_PORT=3000
